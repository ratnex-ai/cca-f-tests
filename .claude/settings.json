{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python3 *.py)",
      "Bash(python -m py_compile *)",
      "Bash(pip show anthropic)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Bash(pip install:*)",
      "Bash(git push:*)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_bash.py\"",
            "statusMessage": "Checking Bash command against deny-patterns (rm -rf, force-push, etc.)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python_syntax.py\"",
            "statusMessage": "Compiling edited .py file to catch syntax errors..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn_pycache.py\"",
            "statusMessage": "Checking for stray __pycache__ dirs..."
          }
        ]
      }
    ]
  }
}
